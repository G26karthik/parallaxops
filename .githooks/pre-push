#!/bin/sh
# Runs the same checks as CI before anything leaves the machine. Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass only for a deliberate emergency: git push --no-verify
ROOT="$(git rev-parse --show-toplevel)"
for cand in "$PARALLAXOPS_PYTHON" \
            "$PARALLAXOPS_HOME/venv/Scripts/python.exe" \
            "$PARALLAXOPS_HOME/venv/bin/python" \
            "$LOCALAPPDATA/ParallaxOps/venv/Scripts/python.exe" \
            "$HOME/.local/share/parallaxops/venv/bin/python" \
            "$ROOT/.venv/bin/python"; do
  if [ -n "$cand" ] && [ -x "$cand" ]; then PY="$cand"; break; fi
done
if [ -z "$PY" ]; then echo "pre-push: no project Python found (set PARALLAXOPS_PYTHON)"; exit 1; fi
echo "pre-push: running CI checks locally"
"$PY" "$ROOT/scripts/check.py" || { echo "pre-push: checks failed; push aborted"; exit 1; }
