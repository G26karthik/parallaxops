# Copy to .env for local development. No real secrets belong in this file or in git.

# Root for all persistent local state (venv, tools, datasets, DB files, object-store data).
# Keep it OUTSIDE any cloud-synced folder. Defaults: %LOCALAPPDATA%/ParallaxOps or ~/.local/share/parallaxops
PARALLAXOPS_HOME=

# Added in later gates (documented here so setup stays reproducible):
DATABASE_URL=postgres://parallaxops:parallaxops@127.0.0.1:5432/parallaxops
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=parallaxops
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
# Shared secret between the worker and the API's internal endpoint (generate your own).
INTERNAL_API_SECRET=change-me-locally
